# Copy to .env and fill in.
PORT=3000

# Timezone used for every time shown or typed in the app.
BUSINESS_TZ=America/Chicago

# Public address of the app, used for the links Stripe sends workers back to.
BASE_URL=http://localhost:3000

# Set to 1 when the app sits behind an HTTPS proxy (Render, Fly, nginx, ...).
# TRUST_PROXY=1

# Stripe secret key. Leave unset to track time and record payments by hand.
# Use a test key (sk_test_...) until you have run a full pay run end to end.
# STRIPE_SECRET_KEY=sk_test_...

# Resend, for the welcome email sent to each new worker. Leave unset to show logins on screen instead.
# EMAIL_FROM must be an address on a domain verified in Resend.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Crew Pay <team@example.com>"

# The daily database backup is emailed to every admin. To send it somewhere else, list the addresses here.
# BACKUP_EMAIL_TO=owner@example.com,books@example.com

# Set to 1 so a pay run that the Stripe balance cannot cover pulls the difference from the bank account
# saved in Stripe, then sends the payments when the money lands (a few business days).
# STRIPE_AUTO_TOPUP=1
# Sandbox only: a test bank token to pull from, since a sandbox has no saved bank account.
# STRIPE_TOPUP_SOURCE=btok_us_verified
